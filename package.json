{
  "name": "db_thing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "bun examples/quickstart.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:node": "node tests/node-smoke.mjs",
    "check": "bun run typecheck && bun test && bun run build && bun run test:node && bun run format:check"
  },
  "devDependencies": {
    "@types/node": "^20",
    "bun-types": "^1.0.15",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  },
  "description": "An embedded relational database with a function-based TypeScript API",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  }
}
